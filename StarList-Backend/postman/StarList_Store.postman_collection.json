{
  "info": {
    "name": "StarList – Store",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId",  "value": "1" },
    { "key": "itemId",  "value": "" }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "1. Get available items",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns array', () => pm.expect(body).to.be.an('array'));",
                  "pm.test('At least one item', () => pm.expect(body.length).to.be.at.least(1));",
                  "const first = body[0];",
                  "pm.test('Item has id',        () => pm.expect(first.id).to.be.a('number'));",
                  "pm.test('Item has itemName',  () => pm.expect(first.itemName).to.be.a('string'));",
                  "pm.test('Item has costCoins', () => pm.expect(first.costCoins).to.be.a('number'));",
                  "pm.test('Item has rarity',    () => pm.expect(first.rarity).to.be.a('string'));",
                  "pm.test('isAvailable is true',() => pm.expect(first.isAvailable).to.be.true);",
                  "pm.collectionVariables.set('itemId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/store/items"
          }
        },
        {
          "name": "2. Buy item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('galaxyItemId present',  () => pm.expect(body.galaxyItemId).to.be.a('number'));",
                  "pm.test('catalogItemId matches', () => pm.expect(body.catalogItemId).to.eql(+pm.collectionVariables.get('itemId')));",
                  "pm.test('itemName present',      () => pm.expect(body.itemName).to.be.a('string'));",
                  "pm.test('coinsSpent present',    () => pm.expect(body.coinsSpent).to.be.a('number'));",
                  "pm.test('newTotalCoins present', () => pm.expect(body.newTotalCoins).to.be.a('number'));",
                  "pm.test('purchaseDate present',  () => pm.expect(body.purchaseDate).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/store/buy/{{itemId}}"
          }
        }
      ]
    },
    {
      "name": "Sad Path",
      "item": [
        {
          "name": "Buy item – already owned (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('title is Item already owned', () => pm.expect(body.title).to.eql('Item already owned'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/store/buy/{{itemId}}"
          }
        },
        {
          "name": "Buy item – item not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('title is Item not found', () => pm.expect(body.title).to.eql('Item not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/store/buy/999999"
          }
        },
        {
          "name": "Buy item – insufficient coins (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Requires a user whose totalCoins is 0 and an available item with cost > 0.",
                  "// Set userId to such a user before running.",
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('title is Insufficient coins', () => pm.expect(body.title).to.eql('Insufficient coins'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/store/buy/{{itemId}}"
          }
        },
        {
          "name": "Buy item – user not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('title is User not found', () => pm.expect(body.title).to.eql('User not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "999999" }
            ],
            "url": "{{baseUrl}}/api/store/buy/{{itemId}}"
          }
        }
      ]
    }
  ]
}
