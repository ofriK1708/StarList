{
  "info": {
    "name": "StarList – Complete Sad Path",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId",  "value": "1" },
    { "key": "jwt",     "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Task Complete",
      "item": [
        {
          "name": "Complete non-existent task → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('title is Task not found', () => pm.expect(body.title).to.eql('Task not found'));",
                  "pm.test('detail present', () => pm.expect(body.detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tasks/999999/complete"
          }
        },
        {
          "name": "Setup: create task for double-complete test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('sadTaskId', pm.response.json().taskId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id",    "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Double-complete test task\",\n  \"difficultyLevel\": \"EASY\"\n}"
            }
          }
        },
        {
          "name": "Complete task (first time) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('coinsEarned is 10 (EASY reward)', () => pm.expect(body.coinsEarned).to.eql(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tasks/{{sadTaskId}}/complete"
          }
        },
        {
          "name": "Complete task (second time) → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('title is Task already completed', () => pm.expect(body.title).to.eql('Task already completed'));",
                  "pm.test('detail present', () => pm.expect(body.detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tasks/{{sadTaskId}}/complete"
          }
        },
        {
          "name": "Cleanup: delete task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{sadTaskId}}"
          }
        }
      ]
    },
    {
      "name": "Task Clear",
      "item": [
        {
          "name": "Clear due-date on non-existent task → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('title is Task not found', () => pm.expect(body.title).to.eql('Task not found'));",
                  "pm.test('detail present', () => pm.expect(body.detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/999999/due-date"
          }
        },
        {
          "name": "Clear duration on non-existent task → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('title is Task not found', () => pm.expect(body.title).to.eql('Task not found'));",
                  "pm.test('detail present', () => pm.expect(body.detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/999999/duration"
          }
        },
        {
          "name": "Setup: create task for deleted-task clear test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clearTaskId', pm.response.json().taskId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id",    "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clear test task\",\n  \"difficultyLevel\": \"EASY\",\n  \"dueDate\": \"2099-01-01T00:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "Delete that task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{clearTaskId}}"
          }
        },
        {
          "name": "Clear due-date on deleted task → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('title is Task not found', () => pm.expect(body.title).to.eql('Task not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{clearTaskId}}/due-date"
          }
        }
      ]
    },
    {
      "name": "Habit Complete",
      "item": [
        {
          "name": "Complete non-existent habit → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('title is Habit not found', () => pm.expect(body.title).to.eql('Habit not found'));",
                  "pm.test('detail present', () => pm.expect(body.detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/habits/999999/complete"
          }
        },
        {
          "name": "Setup: create habit for double-complete test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('sadHabitId', pm.response.json().habitId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id",    "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/habits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Double-complete test habit\",\n  \"frequency\": \"DAILY\",\n  \"difficultyLevel\": \"EASY\"\n}"
            }
          }
        },
        {
          "name": "Complete habit (first time) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('currentStreak is 1', () => pm.expect(body.currentStreak).to.eql(1));",
                  "pm.test('coinsEarned is 10 (EASY, streak 1)', () => pm.expect(body.coinsEarned).to.eql(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/habits/{{sadHabitId}}/complete"
          }
        },
        {
          "name": "Complete habit (second time same day) → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('title is Habit already completed today', () => pm.expect(body.title).to.eql('Habit already completed today'));",
                  "pm.test('detail present', () => pm.expect(body.detail).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/habits/{{sadHabitId}}/complete"
          }
        },
        {
          "name": "Cleanup: delete habit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/habits/{{sadHabitId}}"
          }
        }
      ]
    }
  ]
}
