<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot default logback configuration -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Define properties -->
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/}spring.log}"/>
    <property name="REQUEST_TRACE_FILE" value="logs/request-trace.log"/>

    <!-- Console appender - for all logs -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- Request trace file appender - ONLY for REQUEST_TRACE logger -->
    <appender name="REQUEST_TRACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${REQUEST_TRACE_FILE}</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/request-trace-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Dump file appender - attached to root; receives all logs -->
    <appender name="DUMP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app-dump.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/app-dump-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Task entity file appender - ONLY for TaskService -->
    <appender name="TASK_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/tasks.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/tasks-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- User entity file appender - ONLY for UserService -->
    <appender name="USER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/users.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/users-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Profiles -->
    <!-- Dev Profile -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="DUMP_FILE"/>
        </root>
        <!-- Only REQUEST_TRACE logger writes to the file -->
        <logger name="REQUEST_TRACE" level="INFO" additivity="false">
            <appender-ref ref="REQUEST_TRACE_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="app" level="INFO"/>
        <logger name="controller" level="INFO"/>
        <logger name="service.TaskService" level="INFO" additivity="true">
            <appender-ref ref="TASK_FILE"/>
        </logger>
        <logger name="service.UserService" level="INFO" additivity="true">
            <appender-ref ref="USER_FILE"/>
        </logger>
    </springProfile>

    <!-- Test Profile -->
    <springProfile name="test">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
        <!-- Only REQUEST_TRACE logger writes to the file -->
        <logger name="REQUEST_TRACE" level="TRACE" additivity="false">
            <appender-ref ref="REQUEST_TRACE_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="app" level="TRACE"/>
        <logger name="controller" level="TRACE"/>
        <logger name="service.TaskService" level="INFO" additivity="true">
            <appender-ref ref="TASK_FILE"/>
        </logger>
        <logger name="service.UserService" level="INFO" additivity="true">
            <appender-ref ref="USER_FILE"/>
        </logger>
    </springProfile>

    <!-- Prod Profile -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="DUMP_FILE"/>
        </root>
        <!-- Only REQUEST_TRACE logger writes to the file -->
        <logger name="REQUEST_TRACE" level="WARN" additivity="false">
            <appender-ref ref="REQUEST_TRACE_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="app" level="WARN"/>
        <logger name="controller" level="WARN"/>
        <logger name="service.TaskService" level="WARN" additivity="true">
            <appender-ref ref="TASK_FILE"/>
        </logger>
        <logger name="service.UserService" level="WARN" additivity="true">
            <appender-ref ref="USER_FILE"/>
        </logger>
    </springProfile>
</configuration>
