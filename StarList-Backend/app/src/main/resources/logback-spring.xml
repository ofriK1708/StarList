<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Shared pattern: timestamp, thread, level, MDC correlation ID, logger, message -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [req=%X{reqId:-none}] %logger{36} - %msg%n"/>

    <!-- ===== Appenders ===== -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- Incoming HTTP requests + timing (written by RequestLoggingInterceptor) -->
    <appender name="REQUESTS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/requests/requests.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/requests/requests-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Controller layer events -->
    <appender name="CONTROLLERS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/controllers/controllers.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/controllers/controllers-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Service layer events -->
    <appender name="SERVICES_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/services/services.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/services/services-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- All ERROR-level events from any layer, kept longer for post-incident review -->
    <appender name="ERRORS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/errors/errors.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/errors/errors-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ===== Dev profile ===== -->
    <springProfile name="dev">
        <!-- SQL queries in dev only -->
        <appender name="HIBERNATE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/hibernate/hibernate.log</file>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>utf8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/hibernate/hibernate-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>200MB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- Request interceptor sub-package → requests file only, not controllers file -->
        <logger name="controller.logging" level="INFO" additivity="false">
            <appender-ref ref="REQUESTS_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>

        <logger name="controller" level="DEBUG" additivity="false">
            <appender-ref ref="CONTROLLERS_FILE"/>
            <appender-ref ref="ERRORS_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>

        <logger name="service" level="DEBUG" additivity="false">
            <appender-ref ref="SERVICES_FILE"/>
            <appender-ref ref="ERRORS_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- SQL queries to file; bind params are very verbose so console is excluded -->
        <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
            <appender-ref ref="HIBERNATE_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
            <appender-ref ref="HIBERNATE_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

    <!-- ===== Test profile — console only, no file I/O ===== -->
    <springProfile name="test">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="controller.logging" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <logger name="controller" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <logger name="service" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

    <!-- ===== Prod profile — INFO root, WARN for app layers, requests always logged ===== -->
    <springProfile name="prod">
        <!-- Async wrappers avoid blocking request threads on file I/O -->
        <appender name="ASYNC_REQUESTS" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>8192</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <appender-ref ref="REQUESTS_FILE"/>
        </appender>

        <appender name="ASYNC_CONTROLLERS" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>8192</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <appender-ref ref="CONTROLLERS_FILE"/>
        </appender>

        <appender name="ASYNC_SERVICES" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>8192</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <appender-ref ref="SERVICES_FILE"/>
        </appender>

        <appender name="ASYNC_ERRORS" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>2048</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <appender-ref ref="ERRORS_FILE"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_ERRORS"/>
        </root>

        <!-- Always log requests in prod for audit/latency monitoring -->
        <logger name="controller.logging" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_REQUESTS"/>
        </logger>

        <logger name="controller" level="WARN" additivity="false">
            <appender-ref ref="ASYNC_CONTROLLERS"/>
            <appender-ref ref="ASYNC_ERRORS"/>
        </logger>

        <logger name="service" level="WARN" additivity="false">
            <appender-ref ref="ASYNC_SERVICES"/>
            <appender-ref ref="ASYNC_ERRORS"/>
        </logger>
    </springProfile>

</configuration>
